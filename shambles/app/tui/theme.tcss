Screen {
    background: #0b1020;
    color: #f4f1de;
}

Dashboard {
    width: 100%;
    height: 100%;
    background: #0b1020;
}

#dashboard-body {
    width: 100%;
    height: 1fr;
}

#dashboard-header {
    width: 100%;
    height: auto;
    color: #e07a5f;
    content-align: left top;
}

#shortcut-footer {
    width: 100%;
    height: 1;
    color: #d9a441;
}

#main-panes {
    width: 100%;
    height: 1fr;
    padding: 1 2;
}

#account-list {
    width: 1fr;
    height: 100%;
    background: #11182b;
    border: tall #d9a441;
    scrollbar-size: 0 0;
}

#account-list > AccountRow,
#account-list:focus > AccountRow {
    height: auto;
    color: #f4f1de;
    background: #11182b;
    text-style: none;
}

.account-row {
    height: auto;
}

.group-header {
    color: #d9a441;
    text-style: bold;
}

#account-list > AccountRow.-highlight .account-row {
    background: #1a2238;
    color: #f4f1de;
    border-left: tall #e07a5f;
    text-style: none;
}

#account-details,
#inline-details {
    background: #11182b;
    border: tall #e07a5f;
    padding: 1 2;
}

#account-details {
    width: 2fr;
    height: 100%;
    margin-left: 1;
    overflow-y: auto;
    scrollbar-size: 0 0;
}

#inline-details {
    width: 100%;
    height: auto;
    padding: 0 1;
    color: #f4f1de;
    text-style: none;
}

#terminal-too-small {
    display: none;
    width: 100%;
    height: 100%;
    color: #d9a441;
    text-style: bold;
    content-align: center middle;
    padding: 1;
}

Dashboard.wide #inline-details {
    display: none;
}

Dashboard.medium #account-details,
Dashboard.compact #account-details {
    display: none;
}

Dashboard.medium #inline-details,
Dashboard.compact #inline-details {
    display: block;
}

Dashboard.compact #main-panes {
    padding: 0 1;
}

Dashboard.ascii #account-list {
    border: ascii #d9a441;
}

Dashboard.ascii #account-details,
Dashboard.ascii #inline-details {
    border: ascii #e07a5f;
}

Dashboard.too-short #dashboard-body,
Dashboard.too-short #dashboard-header,
Dashboard.too-short #shortcut-footer {
    display: none;
}

Dashboard.too-short #terminal-too-small {
    display: block;
}

.overlay-panel {
    width: 64;
    max-width: 100%;
    height: auto;
    max-height: 100%;
    padding: 1 2;
    border: tall #d9a441;
    background: #11182b;
}

.overlay-panel.danger {
    border: tall #e07a5f;
}

.overlay-panel.ascii {
    border: ascii #d9a441;
}

.overlay-panel.danger.ascii {
    border: ascii #e07a5f;
}

#add-providers {
    height: auto;
    background: #11182b;
    color: #f4f1de;
    padding: 0;
}

.overlay-panel Static {
    height: auto;
}

.overlay-title {
    color: #e07a5f;
    text-style: bold;
}
